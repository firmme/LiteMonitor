<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationIcon>resources\assets\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <DebugType>none</DebugType>
		<DebugSymbols>false</DebugSymbols>
	  
    <Version>1.3.9</Version><!-- 程序主版本（UpdateChecker / About用） -->
    <AssemblyVersion>1.0.0.0</AssemblyVersion><!-- 稳定不动 -->
    <FileVersion>1.3.9.0</FileVersion><!-- 文件属性显示 -->
  </PropertyGroup>


	<ItemGroup>
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="System.Text.Json" Version="9.0.10" />
  </ItemGroup>

    <!-- 自动复制 themes 与 lang 目录下的所有文件 -->
    <ItemGroup>
        <Content Include="resources\themes\*.json">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
            <CopyToPublishDirectory>Always</CopyToPublishDirectory>
        </Content>

        <Content Include="resources\lang\*.json">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
            <CopyToPublishDirectory>Always</CopyToPublishDirectory>
        </Content>

        <Content Include="resources\plugins\*.json">
            <CopyToOutputDirectory>Always</CopyToOutputDirectory>
            <CopyToPublishDirectory>Always</CopyToPublishDirectory>
        </Content>
    </ItemGroup>
	<ItemGroup>
    <Content Include="使用说明(必读).txt" Condition="Exists('使用说明(必读).txt')">
			<CopyToOutputDirectory>Always</CopyToOutputDirectory>
		</Content>
	</ItemGroup>
	
	
<ItemGroup>
  <Compile Remove="test\**" />
  <Compile Remove="LiteMonitor.Updater\**" />
  <EmbeddedResource Remove="LiteMonitor.Updater\**" />
  <None Remove="LiteMonitor.Updater\**" />
</ItemGroup>
	
<!-- 引入文件资源管理 -->
  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>
<!-- 引入文件资源管理 -->
  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <Folder Include="src\UI\Settings\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="LiteMonitor.Updater\LiteMonitor.Updater.csproj"
                      ReferenceOutputAssembly="false"
                      SkipGetTargetFrameworkProperties="true"
                      GlobalPropertiesToRemove="SelfContained;PublishSingleFile;RuntimeIdentifier;PublishDir;Version;FileVersion" />
  </ItemGroup>

  <Target Name="BuildBundledUpdater" BeforeTargets="GetCopyToOutputDirectoryItems;ComputeFilesToPublish"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <BundledUpdaterDir>$(MSBuildProjectDirectory)\LiteMonitor.Updater\bin\$(Configuration)\bundled\</BundledUpdaterDir>
    </PropertyGroup>
    <MSBuild Projects="LiteMonitor.Updater\LiteMonitor.Updater.csproj"
             Targets="Publish"
             Properties="Configuration=$(Configuration);LiteMonitorBundledPublishDir=$(BundledUpdaterDir)"
             RemoveProperties="SelfContained;PublishSingleFile;RuntimeIdentifier;RuntimeIdentifiers;Version;FileVersion;TargetFramework;Platform;PlatformTarget;PublishDir" />
    <ItemGroup>
      <ContentWithTargetPath Include="$(BundledUpdaterDir)LiteMonitor.Updater.exe"
                             TargetPath="resources\LiteMonitor.Updater.exe"
                             CopyToOutputDirectory="PreserveNewest" />
      <ResolvedFileToPublish Include="$(BundledUpdaterDir)LiteMonitor.Updater.exe"
                             RelativePath="resources\LiteMonitor.Updater.exe"
                             CopyToPublishDirectory="PreserveNewest"
                             ExcludeFromSingleFile="true" />
    </ItemGroup>
  </Target>
</Project>
